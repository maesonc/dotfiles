{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "command-raw",
		"source": "pokeget random --hide-name",
		"padding": {
			"top": 1,
			"left": 10,
			"right": 10
		}
	},
	"display": {
		"separator": "  "
